{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.2.4",
  "identifier": "com.orbit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "width": 1,
        "height": 1
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "aHash97",
    "homepage": "https://github.com/aHash97/orbit-desktop",
    "copyright": "Copyright (c) 2026 aHash97",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Desktop hub orbs for launching shortcuts",
    "longDescription": "Orbit plants glass hub orbs on your Windows desktop. Hover a hub to open a smoked-glass pie menu, drill into folders, and launch shortcuts with a click."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RUE3REE1RTIzMjNGMDMKUldRRFB6TGlwWDNxbVhFQVNIMDdKcG1ZcnlQNldKM21RWmgvN2Rnb01jVlI4b2N5Q3ROeHNBY3oK",
      "endpoints": [
        "https://github.com/aHash97/orbit-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
